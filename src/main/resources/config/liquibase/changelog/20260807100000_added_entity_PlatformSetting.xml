<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260807100000-1" author="dev">
        <createTable tableName="platform_setting">
            <column name="setting_key" type="varchar(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="setting_value" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${datetimeType}"/>
            <column name="updated_by_id" type="bigint"/>
        </createTable>
    </changeSet>

    <changeSet id="20260807100000-2" author="dev">
        <addForeignKeyConstraint
            baseTableName="platform_setting"
            baseColumnNames="updated_by_id"
            constraintName="fk_platform_setting__updated_by_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="20260807100000-3" author="dev">
        <insert tableName="platform_setting">
            <column name="setting_key" value="feature.ai.enabled"/>
            <column name="setting_value" value="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
