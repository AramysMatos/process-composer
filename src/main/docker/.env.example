# Copy this file to .env in the same directory (src/main/docker/.env).
# NEVER commit .env — it contains production secrets.

# --- GHCR image (used by app-prod.yml) ---
GHCR_IMAGE=ghcr.io/YOUR_GITHUB_USER/process-composer:latest

# --- JVM heap (use -Xmx256m -Xms128m on e2-micro) ---
JAVA_OPTIONS=-Xmx512m -Xms256m

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-strong-password
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me-strong-password

# --- JWT (generate: openssl rand -base64 64) ---
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=

# --- GitHub token encryption (min. 32 characters) ---
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Liquibase: use prod,faker on first deploy for demo data; then switch to prod only ---
SPRING_LIQUIBASE_CONTEXTS=prod,faker

# --- Public URL (nip.io hostname, e.g. https://34-56-78-90.nip.io) ---
JHIPSTER_MAIL_BASE_URL=https://YOUR-NIP-IO-HOSTNAME

# --- Vertex AI (Gemini) ---
# Enable Vertex AI API in GCP Console and grant roles/aiplatform.user to the VM service account.
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp
GOOGLE_CLOUD_LOCATION=us-central1
